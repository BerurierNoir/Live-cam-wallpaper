{
  "name": "camwall",
  "productName": "CamWall",
  "version": "6.0.0",
  "description": "Live camera wallpaper for Linux — RTSP, Reolink, Tapo, ONVIF via go2rtc",
  "main": "src/main/index.js",
  "author": { "name": "CamWall", "email": "camwall@localhost" },
  "license": "MIT",
  "scripts": {
    "start":          "electron .",
    "build":          "bash scripts/download-go2rtc.sh && electron-builder",
    "build:appimage": "bash scripts/download-go2rtc.sh && electron-builder --linux AppImage",
    "build:rpm":      "bash scripts/download-go2rtc.sh && electron-builder --linux rpm",
    "build:deb":      "bash scripts/download-go2rtc.sh && electron-builder --linux deb"
  },
  "dependencies": { "js-yaml": "^4.1.0" },
  "devDependencies": {
    "electron":         "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
