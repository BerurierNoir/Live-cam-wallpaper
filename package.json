{
  "name": "camwall",
  "productName": "CamWall",
  "version": "2.0.0",
  "description": "Live camera wallpaper for Linux — RTSP, Reolink, Tapo, ONVIF, MJPEG, HLS",
  "main": "main.js",
  "author": "Your Name",
  "license": "MIT",
  "keywords": ["camera", "rtsp", "wallpaper", "linux", "surveillance", "reolink", "go2rtc", "mjpeg"],
  "scripts": {
    "start":           "electron .",
    "dev":             "NODE_ENV=development electron .",
    "build":           "npm run fetch-go2rtc && electron-builder",
    "build:appimage":  "npm run fetch-go2rtc && electron-builder --linux AppImage",
    "build:deb":       "npm run fetch-go2rtc && electron-builder --linux deb",
    "fetch-go2rtc":    "bash scripts/download-go2rtc.sh"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "electron":         "^31.0.0",
    "electron-builder": "^24.13.0"
  }
}
